# ── Database ─────────────────────────────────────────────────
DB_NAME=game_analytics
DB_USER=postgres
DB_PASSWORD=change_this_password

# ── JWT ───────────────────────────────────────────────────────
# Must be at least 32 characters, keep it secret
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars

# Optional JWT overrides (defaults shown)
# JWT_ISSUER=GameAnalytics
# JWT_AUDIENCE=GameAnalyticsDashboard
# JWT_EXPIRY_HOURS=8

# ── Dashboard ─────────────────────────────────────────────────
# Port the dashboard is accessible on
DASHBOARD_PORT=80

# URL the dashboard is served from (used for CORS)
# Change this if serving on a domain or non-standard port
FRONTEND_URL=http://localhost
