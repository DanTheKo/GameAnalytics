FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY GameAnalytics.csproj ./
RUN dotnet restore GameAnalytics.csproj

COPY . .
RUN dotnet publish GameAnalytics.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

EXPOSE 8080

ENTRYPOINT ["dotnet", "GameAnalytics.dll"]